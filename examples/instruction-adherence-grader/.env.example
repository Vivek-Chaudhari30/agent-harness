# Copy to .env and fill in the key for the selected provider. Tests and CI run
# with MODEL_PROVIDER=fake and need no key.

# Required when MODEL_PROVIDER=openai (the working default for this build).
OPENAI_API_KEY=

# Required only when MODEL_PROVIDER=anthropic. The provider remains supported.
ANTHROPIC_API_KEY=

# "openai" (default), "anthropic", or "fake" for deterministic offline calls.
MODEL_PROVIDER=openai

# The checker / labeler model. This value is read from the environment, never
# hardcoded in application logic. gpt-5.6-luna is the lower-cost iteration option.
MODEL_NAME=gpt-5.6-terra

# Kept separate so writer and checker can later use different model families.
WRITER_MODEL_NAME=gpt-5.6-terra

# Content-addressed disk cache for model calls. A cache hit costs nothing and is
# what makes re-running the batch free and reproducible across the four worktrees.
MODEL_CACHE_DIR=.model_cache

# Concurrency cap. Four parallel agents share one key; keep this modest.
MODEL_MAX_CONCURRENCY=4

# Every model call's raw request and response is appended here (JSONL) so a
# verdict is auditable later rather than a boolean you have to trust.
MODEL_DEBUG_LOG=.model_cache/calls.jsonl
